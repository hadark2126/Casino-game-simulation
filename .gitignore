# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/

# Operating system
.DS_Store
Thumbs.db

# Environment & secrets — NEVER commit
.env
.env.*
*.pem
*.key
*.p12
secrets/
credentials/ 
# Java keystores (often contain private keys + certs)
*.jks
*.keystore
*.truststore

# SSH private keys (in case anyone copies them into the repo by mistake)
id_rsa
id_dsa
id_ecdsa
id_ed25519
id_*.priv
.ssh/

# Cloud credentials
.aws/
.azure/
.gcp/
*credentials*.json
*credentials*.yaml
service-account*.json
gcloud-service-key.json

# API tokens / generic secret files
*.token
*token*
.netrc
.npmrc
.pypirc
.htpasswd

# Database dumps (can contain real user data)
*.sql
*.dump
dump.rdb